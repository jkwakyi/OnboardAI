          <mxGeometry x="556" y="873" width="315" height="127" as="geometry" />
        </mxCell>
        <mxCell id="key_t" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Key&lt;/b&gt;&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="570" y="880" width="60" height="24" as="geometry" />
        </mxCell>
        <mxCell id="key_1" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;data / request flow&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="631" y="908" width="230" height="22" as="geometry" />
        </mxCell>
        <mxCell id="key_2" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;implements interface&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="631" y="934" width="230" height="22" as="geometry" />
        </mxCell>
        <mxCell id="key_3" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;step number (see list below)&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="631" y="960" width="230" height="22" as="geometry" />
        </mxCell>
        <mxCell id="key_c" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;1&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;ellipse;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="584" y="960" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="panel" value="" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="158" y="1162" width="1820" height="259" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Asking a question (steps 1-9)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;1. Employee types a question in the chat page&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;2. Request goes to the backend with the login token&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;3. Chat API sends the question to the QA Controller&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;4. QA Controller asks Retrieval Service for matching sections&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;5. Question gets turned into a vector&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;6. Vector DB returns the top 5 closest sections&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;7. If no good match -&amp;gt; fallback to HR, otherwise build prompt&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;8. LLM generates the answer (JSON with citations)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;9. Chat gets saved and answer goes back to the employee&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="175" y="1170" width="600" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Uploading a document (U1-U4)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;U1. HR admin uploads a document&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;U2. Original file is saved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;U3. Text is extracted and split into sections&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;U4. Sections are turned into vectors and saved&lt;/font&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;*If the LLM times out or errors, the user&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;gets the HR fallback message&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="1170" width="520" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Escalating to a human (E1-E4)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;E1. On a fallback answer, employee clicks &quot;Send to HR&quot;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;E2. Question is saved as an open escalation&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;E3. HR admin sees it in the HR Inbox, replies,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;and marks it resolved&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;E4. Employee sees HR's reply in the chat page&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1357" y="1170" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;HR fallback&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;If the best match is below the relevance&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;threshold, the QA Controller skips the LLM&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;and returns fallback: true with a message&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;directing the employee to HR.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Timeouts, provider errors, and invalid&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;output also return the HR fallback.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Feedback is logged for manual review.&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1712" y="1170" width="255" height="240" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;font style=&quot;font-size: 11px;&quot;&gt;Team: Brad Campos, Jared Ahenkora-Kwakyi, Muhammed Ayday&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="158" y="1434" width="700" height="22" as="geometry" />
        </mxCell>
