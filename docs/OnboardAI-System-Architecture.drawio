        </mxCell>
        <mxCell id="t_hand" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Fake Company Handbook&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;6-8 docs&lt;/font&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;shape=note;size=14;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1">
