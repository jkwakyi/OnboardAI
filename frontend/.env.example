# Frontend configuration. Copy to frontend/.env if you need to change it.
# Vite only exposes variables prefixed VITE_, and it bakes them into the
# bundle at build time - so nothing secret may ever go in this file.

# Where the Backend API is. Leave it unset and the default below is used,
# which is where `uvicorn app.main:app --reload` serves it.
VITE_API_BASE_URL=http://localhost:8000/api
