# OnboardAI local development configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Backend API ---
ONBOARDAI_ENV=development
ONBOARDAI_LOG_LEVEL=INFO

# --- Main Database (PostgreSQL) ---
# Matches the service defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://onboardai:onboardai@localhost:5432/onboardai

# --- Vector Database (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=onboardai_sections

# --- File Storage (original uploaded PDF/TXT files) ---
FILE_STORAGE_DIR=backend/storage/documents

# The largest document that may be uploaded, in bytes. Applied while the
# upload is being written rather than read off the Content-Length header,
# which the client also sets. 10 MB.
MAX_UPLOAD_BYTES=10485760

# Reading an uploaded document (ON-40). ON-39 bounds what arrives; these
# bound what it costs to read. The timeout is checked per page, so a PDF
# crafted to be expensive stops costing rather than being measured
# afterwards. It is its own number, not the LLM Gateway's 20 seconds.
PDF_MAX_PAGES=200
EXTRACTION_MAX_CHARACTERS=1000000
EXTRACTION_TIMEOUT_SECONDS=15

# How big a section is. A section is what gets a vector, what retrieval
# returns five of, and what a citation points at, so this is a retrieval
# decision rather than a storage one.
SECTION_MAX_CHARACTERS=1500
SECTION_MIN_CHARACTERS=200

# --- Embedding API (ON-10) ---
# Hosted provider, called over HTTPS. The key lives here, on the server
# side, only: never in frontend/.env, never in a VITE_ variable, never
# committed. Create one at https://platform.openai.com/api-keys and paste it
# into your own .env. Then prove it works:
#
#     python scripts/check_embedding_api.py
#
# EMBEDDING_DIMENSIONS must match the model, because the ChromaDB collection
# is built for one vector width. text-embedding-3-small returns 1536.
#
# "openai" is the hosted service and the default. "mock" embeds locally
# with lexical vectors and needs no key or account, so CI and teammates
# without a key can still run the whole system - the same arrangement as
# LLM_PROVIDER=mock below. It logs a warning every time it is selected and
# retrieval quality with it is not representative (TD-27).
EMBEDDING_PROVIDER=openai
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# How many sections go in one request. The endpoint takes a list, so this
# is the difference between a few round trips and one per section.
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_API_KEY=

# --- LLM provider selection (ON-18/ON-44) ---
# "mock" keeps CI and teammates without the model running.
LLM_PROVIDER=mock

# --- Relevance threshold (ON-46) ---
# How good the closest retrieved section has to be before the QA
# Controller asks the LLM anything at all. Below this it skips the model
# entirely and the employee gets the HR fallback.
#
# A cosine similarity: 1.0 is "the section says the same thing as the
# question", 0.0 is "nothing in common". 0.22 is what best separated the
# evaluation question set's answerable questions from its unanswerable
# ones - measured against the *mock* embedder, because the Embedding API
# account has no credit. It is provisional and will move when the hosted
# model's scores can be measured. See TD-30.
# RELEVANCE_THRESHOLD=0.22

# --- Auth Service (ON-36) ---
# The key login tokens are signed with. Secret, server-side only: never in
# frontend/.env and never in a VITE_ variable. Generate your own with
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Leave it unset and the backend signs with a random key made at startup,
# which works and logs a warning - you are simply signed out whenever the
# backend restarts. ONBOARDAI_ENV=production refuses to start without it.
# AUTH_SECRET_KEY=

# How long a login lasts, in minutes. 720 is one working day. A token
# cannot be withdrawn once issued (TD-19), so this is the only limit on a
# leaked one; shorten it rather than lengthen it.
AUTH_TOKEN_TTL_MINUTES=720

# --- The two synthetic development accounts (ON-36) ---
# One Employee and one HR administrator, so you can see both halves of the
# application. The addresses end in .example, which RFC 2606 reserves, so a
# demo account can never reach a real mailbox.
SEED_EMPLOYEE_EMAIL=employee@onboardai.example
SEED_HR_EMAIL=hr@onboardai.example
#
# Choose your own two passwords below - there is deliberately no default
# and nothing is written down in the repository, so every checkout is not
# sharing one. Then create the accounts:
#
#     python scripts/seed_accounts.py
#
# Run it again any time to reset them. It never prints a password.
SEED_EMPLOYEE_PASSWORD=
SEED_HR_PASSWORD=

# --- Frontend ---
# Vite reads VITE_-prefixed variables from frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api

# --- Development watcher: live Jira board (optional) ---
# The watcher shows the board without any of this: the assistant writes a
# snapshot as it reads Jira. Set these two only if you want the watcher to
# poll Jira itself every 60 seconds while the assistant is not running.
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# and paste it here, in your own .env. Never commit it.
# JIRA_EMAIL=
# JIRA_API_TOKEN=
