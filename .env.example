# OnboardAI local development configuration.
# Copy to .env and fill in real values. Never commit .env.

# --- Backend API ---
ONBOARDAI_ENV=development
ONBOARDAI_LOG_LEVEL=INFO

# --- Main Database (PostgreSQL) ---
# Matches the service defined in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://onboardai:onboardai@localhost:5432/onboardai

# --- Vector Database (ChromaDB) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=onboardai_sections

# --- File Storage (original uploaded PDF/TXT files) ---
FILE_STORAGE_DIR=backend/storage/documents

# --- Embedding API (ON-10: provider not yet chosen) ---
# EMBEDDING_API_KEY=

# --- LLM provider selection (ON-18/ON-44) ---
# "mock" keeps CI and teammates without the model running.
LLM_PROVIDER=mock

# --- Frontend ---
# Vite reads VITE_-prefixed variables from frontend/.env
VITE_API_BASE_URL=http://localhost:8000/api
